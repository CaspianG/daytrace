{
  "manifest_version": 3,
  "name": "Daytrace Browser Companion",
  "version": "1.0.0",
  "description": "Adds the active tab domain, safe path and title to the local Daytrace timeline. No page content or private tabs.",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Daytrace Browser Companion"
  }
}
