{
  "name": "daytrace-local",
  "version": "0.1.0",
  "private": true,
  "description": "Private, fully local activity timeline and workday recall for Windows.",
  "author": "Daytrace contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CaspianG/daytrace.git"
  },
  "homepage": "https://github.com/CaspianG/daytrace#readme",
  "bugs": {
    "url": "https://github.com/CaspianG/daytrace/issues"
  },
  "keywords": [
    "activity-tracker",
    "local-first",
    "privacy",
    "productivity",
    "windows"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:tracker": "dotnet publish native/windows-tracker/Daytrace.Tracker.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true",
    "dist": "npm run test && npm run build:tracker && npm run build:brand && npm run build && electron-builder --win nsis zip",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "preview": "vite preview",
    "test": "node --test tests/privacy.test.mjs tests/sessionizer.test.mjs tests/event-store.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "build": {
    "appId": "local.daytrace.desktop",
    "productName": "Daytrace",
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "Daytrace-Portable-${version}-${arch}.${ext}",
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "build/icon.ico",
      "LICENSE",
      "README.md",
      "README_RU.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/windows-tracker/bin/Release/net8.0-windows/win-x64/publish/",
        "to": "tracker",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "README_RU.md",
        "to": "README_RU.md"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Daytrace-Setup-${version}-${arch}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Daytrace",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
