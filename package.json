{
  "name": "daytrace-local",
  "version": "0.5.5",
  "private": true,
  "description": "Private, fully local activity timeline and workday recall for Windows and macOS.",
  "author": "Daytrace contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CaspianG/daytrace.git"
  },
  "homepage": "https://github.com/CaspianG/daytrace#readme",
  "bugs": {
    "url": "https://github.com/CaspianG/daytrace/issues"
  },
  "keywords": [
    "activity-tracker",
    "local-first",
    "privacy",
    "productivity",
    "windows",
    "macos"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:tracker": "npm run build:tracker:win",
    "build:tracker:win": "node scripts/build-windows-tracker.cjs",
    "build:tracker:mac": "bash scripts/build-macos-tracker.sh",
    "dist": "npm run dist:win",
    "dist:win": "npm run test && npm run build:tracker:win && npm run build:brand && npm run build && npm run test:desktop && electron-builder --win nsis zip --publish never && npm run test:packaged:win",
    "dist:mac": "npm run test && npm run build:tracker:mac && npm run build:brand && npm run build && npm run test:desktop && electron-builder --mac dmg zip --universal --publish never -c.mac.identity=null -c.mac.notarize=false && bash scripts/bundle-macos-install-guide.sh",
    "dist:mac:release": "node scripts/require-apple-signing.mjs && npm run test && npm run build:tracker:mac && npm run build:brand && npm run build && npm run test:desktop && electron-builder --mac dmg zip --universal --publish never -c.mac.forceCodeSigning=true && bash scripts/bundle-macos-install-guide.sh && bash scripts/verify-macos-release.sh",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "screenshots": "npm run build && electron scripts/capture-screenshots.cjs",
    "preview": "vite preview",
    "test": "node --test tests/privacy.test.mjs tests/sessionizer.test.mjs tests/intent-classifier.test.mjs tests/update-service.test.mjs tests/accessibility-service.test.mjs tests/mac-install-service.test.mjs tests/mac-update-service.test.mjs tests/event-store.test.mjs tests/localization.test.mjs tests/runtime-security.test.mjs tests/native-collector-contract.test.mjs tests/release-docs.test.mjs",
    "test:sites": "npm run build && node --test tests/sites-worker.test.mjs",
    "test:desktop": "node scripts/run-desktop-smoke.cjs",
    "test:packaged:win": "node scripts/run-packaged-windows-smoke.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "10.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "rcedit": "^5.0.2",
    "vite": "6.4.3",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "build": {
    "appId": "local.daytrace.desktop",
    "productName": "Daytrace",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "Daytrace-Portable-${version}-${arch}.${ext}",
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "LICENSE",
      "README.md",
      "README_RU.md",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "README_RU.md",
        "to": "README_RU.md"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "native/windows-tracker/bin/Release/daytrace-win-x64/",
          "to": "tracker/windows",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "binaries": [
        "Contents/Resources/tracker/macos/daytrace-tracker"
      ],
      "artifactName": "Daytrace-${version}-macOS-${arch}.${ext}",
      "extraResources": [
        {
          "from": "native/macos-tracker/build/daytrace-tracker",
          "to": "tracker/macos/daytrace-tracker"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        {
          "x": 155,
          "y": 185
        },
        {
          "x": 505,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 330,
          "y": 350,
          "type": "file",
          "path": "MACOS_INSTALL.txt",
          "name": "READ BEFORE INSTALLING.txt"
        }
      ]
    },
    "nsis": {
      "artifactName": "Daytrace-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daytrace",
      "runAfterFinish": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
